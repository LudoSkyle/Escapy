rules_version = '2';

// The Cloud Functions write every document, with the Admin SDK, which these rules do not apply to.
// A client only reads, and only what is its own. Tested in functions/test/firestoreRules.test.ts.
service cloud.firestore {
  match /databases/{database}/documents {

    // A profile is read by its owner only: the other players see the name and avatar copied into
    // each game they share
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;

      // The list of their games, for the home screen: read by its owner only
      match /games/{gameId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    // A game is read by its members: its game master and its players. A game that does not exist
    // reads as missing, not as refused: a member sees their game deleted, not an error. Its id is
    // random, so this tells nothing to anyone else
    match /games/{gameId} {
      // A game opens by its id; no client lists the games: the home screen reads users/{uid}/games
      allow get: if request.auth != null
        && (resource == null || request.auth.uid in resource.data.memberIds);
      allow write: if false;

      match /players/{playerId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/games/$(gameId)).data.memberIds;
        allow write: if false;
      }

      // The chat, the one thing a client writes: a member sends a message in their own name, with
      // the name and avatar of their profile, at the time of the server, while the game is played.
      // A message is never changed or deleted; it goes with its game. Tested in
      // functions/test/firestoreRules.test.ts
      match /messages/{messageId} {
        allow read: if request.auth != null && request.auth.uid in game(gameId).data.memberIds;
        allow create: if request.auth != null
          && request.auth.uid in game(gameId).data.memberIds
          && isChatOpen(game(gameId).data)
          && isOwnMessage(request.resource.data);
        allow update, delete: if false;
      }

      // The missions as the players see them, created when unlocked: never an answer
      match /missions/{missionId} {
        allow read: if request.auth != null && request.auth.uid in game(gameId).data.memberIds;
        allow write: if false;
      }

      // The missions as the game master wrote them, answers and locked ones included: for the game
      // master only. The app opens this observation for them only, a refusal elsewhere would leave
      // the Android SDK late on the other observations (see docs/KMP/01_MODULE_DATA.md)
      match /masterMissions/{missionId} {
        allow read: if request.auth != null && request.auth.uid == game(gameId).data.masterId;
        allow write: if false;
      }

      // games/{gameId}/private: the excluded players, for the functions only (refused below)
    }

    // joinCodes and joinAttempts are for the functions only: a client neither lists the codes nor
    // reads a game without its code

    function game(gameId) {
      return get(/databases/$(database)/documents/games/$(gameId));
    }

    // Played: paused, or running before its end. A game whose end has passed is over even before a
    // function records it, as for the functions (see functions/src/game/timer.ts)
    function isChatOpen(game) {
      return game.status == 'PAUSED' || (game.status == 'RUNNING' && game.endsAt > request.time);
    }

    function isOwnMessage(message) {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return message.keys().hasOnly(['authorId', 'author', 'text', 'sentAt'])
        && message.keys().hasAll(['authorId', 'author', 'text', 'sentAt'])
        && message.authorId == request.auth.uid
        && message.author.keys().hasOnly(['username', 'avatarId'])
        && message.author.username == profile.username
        && message.author.avatarId == profile.avatarId
        && message.text is string
        && message.text.size() <= 500
        && message.text.trim().size() > 0
        && message.sentAt == request.time;
    }

    // Everything else is refused, until a lot opens it with its tests
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
